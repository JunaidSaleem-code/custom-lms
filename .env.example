# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (project: custom-lms-dev) ---
NEXT_PUBLIC_SUPABASE_URL=https://bqziqwehhyctibzxexfs.supabase.co
# Publishable key. Safe for browser code; row-level security controls access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key. Server only. Bypasses RLS. Never add a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# --- App ---
# Public URL of this app. Used in auth emails. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare Stream (video). Needed to play lessons. ---
# Signing key id and PKCS#8 private key (base64). Created in Stream > Settings > Signing Keys.
STREAM_SIGNING_KEY_ID=
STREAM_SIGNING_PRIVATE_KEY_BASE64=

# --- Sign-up ---
# "true" shows the Create account flow. Also turn on "Allow new users to sign up" in Supabase.
# Leave "false" for invite-only access.
SIGNUP_ENABLED=false
